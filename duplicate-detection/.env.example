# CivicFix Duplicate Candidate Detection Engine Configuration

# Implementation Decision (not mandated by SRS): Embedding model & vector dimension
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384

# Candidate Retrieval limit
VECTOR_TOP_K=10

# SRS Required: Configurable duplicate similarity / composite threshold
# Empirical evaluation on 50-case benchmark selected 0.75 (F1: 0.9474, Precision: 0.9310, Recall: 0.9643)
DUPLICATE_SIMILARITY_THRESHOLD=0.75

# Implementation Decision (not mandated by SRS): Location decay radius in km
LOCATION_DISTANCE_THRESHOLD_KM=5.0

# Implementation Decision (not mandated by SRS): Configurable multi-factor scoring weights (Must sum to 1.0)
SEMANTIC_WEIGHT=0.50
PRIMARY_DOMAIN_WEIGHT=0.15
SUBCATEGORY_WEIGHT=0.15
SECONDARY_DOMAIN_WEIGHT=0.10
LOCATION_WEIGHT=0.10
