# Environment configuration files (never commit secrets)
.env
.env.*
!.env.example

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Pytest & Coverage output
.pytest_cache/
.coverage
htmlcov/
.coverage.*

# Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# IDE & Editor configurations
.vscode/
.idea/
*.swp
*.swo
*~

# Logs & Debugging
*.log
logs/

# Operating System files
.DS_Store
Thumbs.db
desktop.ini

# SQLite / Database dumps
*.sqlite
*.sqlite3
*.db

# Build & Packaging artifacts
dist/
build/
*.egg-info/
*.egg

# Mypy / Ruff cache
.mypy_cache/
.ruff_cache/

# Temporary files
*.tmp
*.temp
