# ─── CivicFix Engine — Environment Variables ──────────────────────────────────
# Copy this file to .env and fill in your values.

# ─── Server ───────────────────────────────────────────────────────────────────
APP_TITLE="CivicFix Integrated AI Engine & Capability Portal"
APP_VERSION="1.0.0"
HOST=0.0.0.0
PORT=8000

# ─── Database ─────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=civicfix

# ─── Feature 1: Classification Engine ────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
LLM_TIMEOUT_SECONDS=60.0
LLM_MAX_RETRIES=3
AI_HIGH_CONFIDENCE_THRESHOLD=0.85
AI_REVIEW_THRESHOLD=0.60

# ─── Feature 2: Duplicate Detection Engine ───────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
VECTOR_TOP_K=10
DUPLICATE_SIMILARITY_THRESHOLD=0.75
STRONG_CANDIDATE_THRESHOLD=0.85
SEMANTIC_STRONG_THRESHOLD=0.82
SEMANTIC_CANDIDATE_THRESHOLD=0.70
LOCATION_DISTANCE_THRESHOLD_KM=5.0

# Multi-factor weights (must sum to 1.0 for full signal availability)
SEMANTIC_WEIGHT=0.50
PRIMARY_DOMAIN_WEIGHT=0.15
SUBCATEGORY_WEIGHT=0.15
SECONDARY_DOMAIN_WEIGHT=0.10
LOCATION_WEIGHT=0.10
SCORING_VERSION=duplicate-v2

# ─── Feature 3: University Matching ──────────────────────────────────────────
DEFAULT_ASSIGNMENT_DEADLINE_HOURS=48
DEFAULT_REMINDER_WINDOW_HOURS=12
DEV_MODE=true
SEED_ON_STARTUP=true
