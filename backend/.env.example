# CivicFix Main Backend Orchestrator Configuration

# Database Configuration (MongoDB)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=civicfix

# Microservice Integration URLs
CLASSIFICATION_SERVICE_URL=http://localhost:8000
DUPLICATE_DETECTION_SERVICE_URL=http://localhost:8001

# Microservice Client Timeouts (seconds)
CLASSIFICATION_SERVICE_TIMEOUT=60.0
DUPLICATE_DETECTION_SERVICE_TIMEOUT=30.0

# Workflow Safeguards & Thresholds
AI_HIGH_CONFIDENCE_THRESHOLD=0.85
